# Copy to .env for local development. Never commit real values.
# development (default) or production.
GATEDEBT_ENV=development
# SQLite file for the registry (created and migrated on first run).
GATEDEBT_DB_PATH=./gatedebt.sqlite3
# Where rehearsal reports are written.
GATEDEBT_ARTIFACTS_DIR=./artifacts/runs
# dev-header (development only, NOT authentication) or none.
# Production refuses dev-header; with none, every write is rejected.
GATEDEBT_AUTH_MODE=dev-header
# Comma-separated actors allowed to approve renewals and retirements.
GATEDEBT_APPROVERS=user:bob,user:carol
# Only needed once the GitLab integration is enabled (Milestone 5+).
# Use a project access token with the minimum scope required (read_api to start).
GITLAB_URL=https://gitlab.com
GITLAB_PROJECT_ID=
GITLAB_TOKEN=
